# Single source of truth for this environment's Zitadel identifiers.
#
# Copy to zitadel-ids.env and fill in the values (the real file is gitignored
# -- the IDs identify a live Zitadel instance and change when it is rebuilt):
#
#   cp zitadel-ids.env.template zitadel-ids.env
#
# These are NOT secrets -- they are object IDs. They live in one file because
# they are otherwise scattered as literals across eight Helm values files (20
# occurrences), and every one of them changes when Zitadel is rebuilt.
# Hand-patching them is exactly the failure mode this file prevents: four
# backends once kept a placeholder project id and silently denied every
# authenticated request with "Forbidden resource" inside an HTTP 200.
#
# To apply after a (re)build:
#   1. run the Zitadel setup script against the new instance
#   2. put the four IDs it reports below
#   3. ./scripts/set-zitadel-ids.sh          # rewrites every values file
#   4. commit, then let ArgoCD sync
#
# ALSO derived from Zitadel and NOT covered by the script -- both live in AWS
# Secrets Manager and must be refreshed by hand on a rebuild:
#   - hello-openshift/<env>/chat-secrets  -> JWT_PUBLIC_KEY (from the Zitadel JWKS)
#   - hello-openshift/<env>/scope-management-secrets -> ZITADEL_PAT (IAM_OWNER PAT)

# Project "unique" -- the project every service resolves roles against. Consumed
# as ZITADEL_PROJECT_ID; the backends read the caller's roles from the token
# claim urn:zitadel:iam:org:project:${ZITADEL_PROJECT_ID}:roles, so a wrong
# value here makes every request look role-less.
ZITADEL_PROJECT_ID=<project-id>

# Root org "Cluster IAM" -- where the project and the machine users live.
ZITADEL_ROOT_ORG_ID=<root-org-id>

# Tenant org -- the org end users belong to and log in against.
ZITADEL_ORG_ID=<org-id>

# SPA OIDC client shared by the chat, admin and knowledge-upload frontends.
ZITADEL_CLIENT_ID=<client-id>

# Public issuer. Changes only if the domain changes.
ZITADEL_ISSUER=https://id.openshift.example.com
