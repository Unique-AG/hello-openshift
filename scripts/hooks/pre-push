#!/bin/bash
set -euo pipefail

#######################################
# Pre-push hook
#######################################
#
# The wider net than pre-commit: full-history secret scan, every kustomization
# built, terraform fmt and validate. A failure here blocks the push -- the
# earlier version of this hook ended in an unconditional `exit 0`, so nothing
# it detected ever stopped anything.
#
# Bypass in an emergency with `git push --no-verify`.
#
#######################################

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${HOOK_DIR}/../.." && pwd)"
cd "$PROJECT_ROOT"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; NC='\033[0m'
FAILED=0

echo -e "${BLUE}🚀 pre-push${NC}"

#######################################
# 1. Secrets, full history
#######################################
ZERO=0000000000000000000000000000000000000000

scan_range() {  # <git-log-range>
  gitleaks git --log-opts="$1" --config scripts/gitleaks-config.toml \
    --redact --no-banner >/dev/null 2>&1 && return 0
  echo -e "${RED}❌ BLOCKED: secrets detected in $1${NC}"
  gitleaks git --log-opts="$1" --config scripts/gitleaks-config.toml \
    --redact --no-banner -v 2>&1 | sed 's/^/    /'
  echo -e "${YELLOW}💡 bypass (emergency only): git push --no-verify${NC}"
  return 1
}

if ! command -v gitleaks >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠️  gitleaks not found — skipping secret scan${NC}"
else
  # Scan exactly the commits being pushed. Two things this avoids:
  #   * the previous `--branches=$(git rev-parse --abbrev-ref HEAD)` expanded to
  #     `--branches=HEAD` on a detached HEAD, matching no branch, scanning
  #     nothing, and reporting clean;
  #   * scanning every ref in the repository, which re-reports findings from
  #     unrelated branches on every push and trains people to use --no-verify.
  scanned=0
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue                 # branch deletion
    if [ "$remote_sha" = "$ZERO" ]; then
      scan_range "$local_sha" || exit 1                    # new branch: its full history
    else
      scan_range "${remote_sha}..${local_sha}" || exit 1   # only the new commits
    fi
    scanned=1
  done
  # No stdin means the hook was invoked by hand; fall back to this branch.
  if [ "$scanned" -eq 0 ]; then
    scan_range HEAD || exit 1
  fi
  echo -e "${GREEN}✅ no secrets in the commits being pushed${NC}"
fi

#######################################
# 2. Kustomize
#######################################
KUSTOMIZE=""
command -v kustomize >/dev/null 2>&1 && KUSTOMIZE="kustomize build"
[ -z "$KUSTOMIZE" ] && command -v kubectl >/dev/null 2>&1 && KUSTOMIZE="kubectl kustomize"
[ -z "$KUSTOMIZE" ] && command -v oc >/dev/null 2>&1 && KUSTOMIZE="oc kustomize"

if [ -z "$KUSTOMIZE" ]; then
  echo -e "${YELLOW}⚠️  no kustomize/kubectl/oc — skipping kustomize validation${NC}"
else
  bad=0
  while read -r dir; do
    $KUSTOMIZE "$dir" >/dev/null 2>&1 || { echo -e "${RED}❌ kustomize build failed: $dir${NC}"; bad=1; }
  done < <(find gitops -name kustomization.yaml -exec dirname {} \; | sort)
  [ "$bad" -eq 0 ] && echo -e "${GREEN}✅ all kustomizations build${NC}" || FAILED=1
fi

#######################################
# 3. Terraform
#######################################
if ! command -v terraform >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠️  terraform not found — skipping terraform validation${NC}"
else
  if terraform fmt -check -recursive terraform >/dev/null 2>&1; then
    echo -e "${GREEN}✅ terraform fmt${NC}"
  else
    echo -e "${RED}❌ terraform fmt: run 'make fmt'${NC}"
    terraform fmt -check -recursive terraform 2>&1 | sed 's/^/    /'
    FAILED=1
  fi

  for stack in terraform/*/; do
    [ -d "${stack}.terraform" ] || continue
    name=$(basename "$stack")
    if terraform -chdir="$stack" validate -no-color >/dev/null 2>&1; then
      echo -e "${GREEN}✅ terraform validate: ${name}${NC}"
    else
      echo -e "${RED}❌ terraform validate: ${name}${NC}"
      terraform -chdir="$stack" validate -no-color 2>&1 | sed 's/^/    /'
      FAILED=1
    fi
  done
fi

if [ "$FAILED" -ne 0 ]; then
  echo -e "${RED}❌ pre-push failed${NC}"
  exit 1
fi
echo -e "${GREEN}✅ pre-push passed${NC}"
